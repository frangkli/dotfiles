{{ if lookPath "systemctl" -}}
#!/bin/sh -l
# Builds Lectern when workspace/lectern has moved since the last build, then restarts it. Runs on
# every apply and compares commits itself, so it works whenever chezmoi pulls externals. Sorts before
# enable-lectern. It builds beside the live dist/ and swaps only on success, so a failed build leaves
# Lectern running.
set -e
# A new box gets Vite+, and so pnpm, by hand after its first apply; the next apply builds.
command -v pnpm >/dev/null || { echo "build-lectern: no pnpm yet, skipping; install Vite+ and apply again" >&2; exit 0; }
cd "$HOME/workspace/lectern"
built="${XDG_STATE_HOME:-$HOME/.local/state}/lectern-built"
head=$(git rev-parse HEAD)
[ "$(cat "$built" 2>/dev/null)" = "$head" ] && exit 0
trap 'rm -rf dist.new' EXIT
pnpm install --frozen-lockfile
pnpm build --outDir dist.new
rm -rf dist
mv dist.new dist
mkdir -p "$(dirname "$built")"
echo "$head" > "$built"
systemctl --user daemon-reload
systemctl --user restart lectern.service
{{ end -}}
