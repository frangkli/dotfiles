# Every login shell reads this, agents included, so keep it POSIX and silent.
for dir in "$HOME/.cargo/bin" "$HOME/.local/share/mise/shims" "$HOME/.local/bin"; do
  case ":$PATH:" in *":$dir:"*) ;; *) PATH="$dir:$PATH" ;; esac
done
if [ -f "$HOME/.config/vite-plus/env" ]; then . "$HOME/.config/vite-plus/env"; fi
export EDITOR=nvim
# CLI telemetry off. Neon has only a per-command --no-analytics flag.
export CF_SEND_TELEMETRY=false SENTRY_CLI_NO_TELEMETRY=1 CTX7_TELEMETRY_DISABLED=1

if [ -n "$BASH_VERSION" ] && [ -f "$HOME/.bashrc" ]; then . "$HOME/.bashrc"; fi
