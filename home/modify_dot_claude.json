{{- /* chezmoi:modify-template */ -}}
{{- /* Sets only the MCP servers; Claude Code owns the rest of this file. */ -}}
{{- /* When they already match, the file passes through untouched, so Claude's key order shows no drift. */ -}}
{{- $state := dict -}}
{{- if .chezmoi.stdin -}}{{- $state = fromJson .chezmoi.stdin -}}{{- end -}}
{{- $servers := dict -}}
{{- range $name, $url := .mcp -}}
{{-   $_ := set $servers $name (dict "type" "http" "url" $url) -}}
{{- end -}}
{{- if and .chezmoi.stdin (eq (toJson (get $state "mcpServers" | default dict)) (toJson $servers)) -}}
{{-   .chezmoi.stdin -}}
{{- else -}}
{{-   $state | setValueAtPath "mcpServers" $servers | toPrettyJson -}}
{{- end -}}
