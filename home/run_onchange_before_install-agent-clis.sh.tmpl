{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh -l
# Vite+ (node, npx, pnpm), Claude Code and boat, before the scripts that need them. devbox-update upgrades Vite+; Claude Code updates itself.
set -e
# Vite+ leaves the shell files alone: chezmoi owns them, and ~/.profile already sources its env.
command -v vp >/dev/null || curl -fsSL https://vite.plus | VP_NODE_MANAGER=yes VP_SELF_SETUP_NO_MODIFY_PATH=1 bash
command -v claude >/dev/null || curl -fsSL https://claude.ai/install.sh | bash
# boat's installer rewrites the shell files chezmoi owns, so fetch the binary as its Docker docs do. It updates itself.
command -v boat >/dev/null || { curl -fsSL "https://boat.dev/api/boat/cli/download?platform=linux-$(uname -m | sed 's/x86_64/x64/;s/aarch64/arm64/')&channel=prod" -o ~/.local/bin/boat && chmod +x ~/.local/bin/boat; }
{{ end -}}
