{{ if lookPath "apt-get" -}}
#!/bin/sh
{{- if stat "/etc/machine-id" }}
# Reruns on a new VM, since a rebuild keeps this state on the data disk but not the packages: {{ include "/etc/machine-id" | sha256sum }}
{{- end }}
set -e
sudo apt-get update -qq
sudo apt-get install -y {{ .packages.apt | join " " }}
{{ else if lookPath "brew" -}}
#!/bin/sh
set -e
brew install {{ .packages.brew | join " " }}
{{ end -}}
