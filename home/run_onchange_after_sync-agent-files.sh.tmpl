{{ if eq .chezmoi.os "linux" -}}
{{- $fstack := joinPath .chezmoi.homeDir "workspace/fstack" -}}
{{- $sum := "" -}}
{{- range concat (glob (joinPath $fstack "skills/**")) (glob (joinPath $fstack "agents/**")) -}}
{{-   if not (stat .).isDir }}{{ $sum = print $sum . (include . | sha256sum) }}{{ end -}}
{{- end -}}
#!/bin/sh
# Copies fstack's skills and Claude agents into place. To retire one, delete it there and list it in .chezmoiremove.
# Reruns when any of them changes: {{ $sum | sha256sum }}
set -e
mkdir -p "$HOME/.agents/skills" "$HOME/.claude/agents"
for entry in {{ joinPath $fstack "skills" | quote }}/*; do
  rsync -a --delete "$entry" "$HOME/.agents/skills/"
done
rsync -a {{ joinPath $fstack "agents" | quote }}/ "$HOME/.claude/agents/"
{{ end -}}
