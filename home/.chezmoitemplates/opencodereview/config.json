{{- /* ocr fetches its key through fnox, so it runs without a wrapper and no key is stored here.
     Astra needs OpenAI's Responses API; Opus stays set up as the fallback provider. */ -}}
{
  "provider": "openai-responses",
  "providers": {
    "openai-responses": {
      "model": "gpt-6-astra",
      "api_key_cmd": "fnox exec -- printenv OPENAI_API_KEY"
    },
    "anthropic": {
      "model": "claude-opus-5-5",
      "api_key_cmd": "fnox exec -- printenv ANTHROPIC_API_KEY"
    }
  }
}
