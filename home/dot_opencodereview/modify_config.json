{{- /* chezmoi:modify-template */ -}}
{{- /* ocr fetches its key through fnox under its own name, so ANTHROPIC_API_KEY never reaches other programs' environment. */ -}}
{{- $config := dict -}}
{{- if .chezmoi.stdin -}}{{- $config = fromJson .chezmoi.stdin -}}{{- end -}}
{{- $config
    | setValueAtPath "provider" "anthropic"
    | setValueAtPath "providers.anthropic.model" "claude-opus-4-6"
    | setValueAtPath "providers.anthropic.api_key_cmd" "fnox exec -- printenv OCR_ANTHROPIC_API_KEY"
    | toPrettyJson -}}
