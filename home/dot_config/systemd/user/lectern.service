[Unit]
Description=Lectern: docs/ and internal/docs/ from every checkout

[Service]
# Lectern, built by build-lectern. Tailnet-only HTTPS on the same port: `tailscale serve --bg --https=7777 http://127.0.0.1:7777`.
Environment=HOST=127.0.0.1 PORT=7777
ExecStart=%h/.local/share/vite-plus/bin/node %h/workspace/lectern/dist/server/entry.mjs
Restart=on-failure

[Install]
WantedBy=default.target
