[Unit]
Description=Docs hub: plans, research and specs from every checkout

[Service]
# Tailnet-only HTTPS on the same port: `tailscale serve --bg --https=7777 http://127.0.0.1:7777`.
ExecStart=%h/.local/share/vite-plus/bin/node %h/.local/share/docs-hub/server.mjs --port 7777
Restart=on-failure

[Install]
WantedBy=default.target
